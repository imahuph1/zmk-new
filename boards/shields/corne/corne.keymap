#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | none |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | none |
// | none |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  '  | none |
// | none |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | none |
//                    | ESC | LWR | ent |   | spc | RSE  | DEL |
                        bindings = <
   &none &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &none
   &none &mt LSHIFT A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &mt RSHIFT APOSTROPHE &none
   &none &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &none
                  &kp ESC &to 1 &kp RET &mt LGUI SPACE &to 2 &kp DEL
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// | NONE |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | None |
// | None | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     | None |
// | None |     |     |     |     |     |   |     |     |     |     |     | None |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &none &kp N1     &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &none
   &none &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp RSHIFT &none
   &none &studio_unlock     &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &none
                                 &trans       &to 0       &trans         &trans   &to 0   &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// | None |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | None |
// | None |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  | None |
// | None |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" | None |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &none  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &none
   &none &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH  &none
   &none &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE  &none
                             &kp ESC &to 0   &kp RET   &kp SPACE   &to 0    &kp DEL
                        >;
                };
        };
};
